FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

COPY requirements.django.txt .

RUN pip install --no-cache-dir -r requirements.django.txt

COPY django_admin/ .
COPY gunicorn.django.conf.py .

EXPOSE 8000

CMD ["gunicorn", "--config", "gunicorn.django.conf.py", "config.wsgi:application"]